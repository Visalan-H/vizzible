PORT=3000

MONGODB_URI=mongodb://localhost:27017/heatmap

# Any long random string. Rotate if it's ever exposed (e.g. pasted into a
# chat log, committed by accident) — doing so invalidates all existing
# sessions, which is harmless, people just need to sign in again.
JWT_SECRET=

# GitHub OAuth App credentials: github.com/settings/developers
# Authorization callback URL on the app must match GITHUB_OAUTH_CALLBACK_URL below exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Must match the frontend's dev server / deployed origin exactly (used for
# CORS and for building redirect URLs after OAuth).
CLIENT_URL=http://localhost:5173

# Exactly 64 hex characters (32 bytes) — used to AES-256-GCM encrypt GitHub
# access tokens at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key after tokens already exist will make those existing
# tokens fail to decrypt silently (falls back to treating them as invalid) —
# affected users just need to sign in again to get a token re-encrypted
# under the new key.
TOKEN_ENCRYPTION_KEY=
