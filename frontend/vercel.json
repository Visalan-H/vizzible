{
  "rewrites": [
    {
      "source": "/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(Twitterbot|facebookexternalhit|Facebot|Discordbot|Slackbot|TelegramBot|LinkedInBot|WhatsApp|redditbot|Pinterest|SkypeUriPreview|vkShare|Iframely|[Bb]ot)"
        }
      ],
      "destination": "https://vizzible-api.vercel.app/api/profiles/:username/meta"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
